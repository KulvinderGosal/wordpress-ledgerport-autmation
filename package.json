{
  "name": "ledgerport-playwright-tests",
  "version": "1.0.0",
  "description": "Playwright E2E regression tests for the LedgerPort WordPress plugin",
  "scripts": {
    "test": "npx playwright test --config=playwright.config.ts",
    "test:regression": "npx playwright test --config=playwright.config.ts regression",
    "test:dashboard": "npx playwright test --config=playwright.config.ts dashboard",
    "test:disconnected": "npx playwright test --config=playwright.config.ts disconnected-state",
    "test:connection": "npx playwright test --config=playwright.config.ts connection",
    "test:mappings": "npx playwright test --config=playwright.config.ts mappings",
    "test:restricted": "npx playwright test --config=playwright.config.ts restricted-pages",
    "test:debug-logs": "npx playwright test --config=playwright.config.ts debug-logs",
    "test:headed": "npx playwright test --config=playwright.config.ts --headed",
    "test:ui": "npx playwright test --config=playwright.config.ts --ui",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0"
  }
}
