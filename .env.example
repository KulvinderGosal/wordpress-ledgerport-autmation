# LedgerPort WordPress plugin — Playwright test env.
# Copy to .env (gitignored). Never commit real credentials — the private
# "QA of LedgerPort" Google Sheet is the master for actual logins.

QA_ENV=staging
QA_TESTER=your-name
BASE_URL=https://qastaging.pushengage.com

# WordPress admin login — used by global-setup.ts (pre-auth) and the modern
# fixture (tests/modern/fixtures/auth.ts). Without these, admin tests skip.
WP_ADMIN_USER=
WP_ADMIN_PASS=
